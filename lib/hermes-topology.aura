; lib/hermes-topology.aura — Axis A: pure-Aura multi-agent topology
;
; (require "hermes-topology" all:)
;
; Phase 1 surface: coordination topology as a first-class pure-Aura object.
; Single host / single process. No wire / transport (those are Phase 4 E).
;
; Topology model:
;   agents  — list of agent names (strings)
;   routes  — list of (from region next)  ; region "" = default/any
;   roles   — hash name → handler (lambda (msg) → msg-or-#f)
;   inbox   — hash name → list of delivered payloads (collector sinks)
;   faults  — hash control plane (Phase 3):
;               "paused" → hash name → 1
;               "drops"  → hash name → remaining drop count
;               "events" → list of event alists (newest first)
;
; Message:
;   (id from to region payload hops)
;   id/from/to/region strings; payload number; hops count.
;
; Delivery: hop-by-hop via route table until to == current or max hops.
; Failure & partiality (Axis C) are first-class: pause / drop / log / recover.

(export hermes:topology-version
        hermes:msg-id hermes:msg-from hermes:msg-to
        hermes:msg-region hermes:msg-payload hermes:msg-hops
        hermes:make-msg hermes:msg-with-hops hermes:msg-with-from
        hermes:make-topology
        hermes:topo-agents hermes:topo-routes hermes:topo-roles
        hermes:topo-inbox hermes:topo-faults
        hermes:bind-role!
        hermes:rebind-role!
        hermes:set-routes!
        hermes:copy-routes
        hermes:clear-inbox!
        hermes:route-next
        hermes:topo-complete?
        hermes:deliver-once!
        hermes:deliver!
        hermes:send!
        hermes:inbox-ref hermes:inbox-sum hermes:inbox-count
        hermes:snapshot-topology
        hermes:restore-topology-routes!
        hermes:fault-log!
        hermes:fault-events
        hermes:fault-event-count
        hermes:fault-clear-events!
        hermes:agent-paused?
        hermes:pause-agent!
        hermes:resume-agent!
        hermes:inject-drops!
        hermes:drops-remaining
        hermes:consume-drop!
        hermes:clear-faults!
        hermes:default-worker-east hermes:default-worker-west
        hermes:default-worker-scale
        hermes:default-router-pass hermes:default-collector
        hermes:build-star-topology
        hermes:star-routes-normal
        hermes:star-routes-swapped
        hermes:star-routes-failover-east
        hermes:run-region-workload!
        hermes:run-region-workload-factors!
        hermes:run-east-workload!)

(require "hermes-measure" all:)

(define hermes:topology-version 3)

; ── Message accessors ──

(define (hermes:msg-id m) (car m))
(define (hermes:msg-from m) (car (cdr m)))
(define (hermes:msg-to m) (car (cdr (cdr m))))
(define (hermes:msg-region m) (car (cdr (cdr (cdr m)))))
(define (hermes:msg-payload m) (car (cdr (cdr (cdr (cdr m))))))
(define (hermes:msg-hops m) (car (cdr (cdr (cdr (cdr (cdr m)))))))

(define (hermes:make-msg id from to region payload)
  (list id from to region payload 0))

(define (hermes:msg-with-hops m hops)
  (list (hermes:msg-id m)
        (hermes:msg-from m)
        (hermes:msg-to m)
        (hermes:msg-region m)
        (hermes:msg-payload m)
        hops))

(define (hermes:msg-with-from m from)
  (list (hermes:msg-id m)
        from
        (hermes:msg-to m)
        (hermes:msg-region m)
        (hermes:msg-payload m)
        (hermes:msg-hops m)))

; ── Topology object: (agents routes roles-hash inbox-hash faults-hash) ──
; Faults hash fields inlined (avoid private free-helper residual).

(define (hermes:make-topology agents routes)
  (hermes:stats-bump! "topo_builds")
  (let ((faults (hash)))
    (hash-set! faults "paused" (hash))
    (hash-set! faults "drops" (hash))
    (hash-set! faults "events" (quote ()))
    (list agents routes (hash) (hash) faults)))

(define (hermes:topo-agents t) (car t))
(define (hermes:topo-routes t) (car (cdr t)))
(define (hermes:topo-roles t) (car (cdr (cdr t))))
(define (hermes:topo-inbox t) (car (cdr (cdr (cdr t)))))
(define (hermes:topo-faults t) (car (cdr (cdr (cdr (cdr t))))))

; ── Fault control plane (Axis C + E) ──

(define (hermes:fault-log! t kind at msg-id region detail)
  (let ((faults (hermes:topo-faults t)))
    (let ((ev (list (cons ":kind" kind)
                    (cons ":at" at)
                    (cons ":msg_id" (if msg-id msg-id ""))
                    (cons ":region" (if region region ""))
                    (cons ":detail" (if detail detail "")))))
      (let ((prev (hash-ref faults "events" #f)))
        (let ((xs (if (list? prev) prev (quote ()))))
          (hash-set! faults "events" (cons ev xs))
          (hermes:stats-bump! "events_logged")
          ev)))))

(define (hermes:fault-events t)
  (let ((v (hash-ref (hermes:topo-faults t) "events" #f)))
    (if (list? v) v (quote ()))))

(define (hermes:fault-event-count t)
  (length (hermes:fault-events t)))

(define (hermes:fault-clear-events! t)
  (hash-set! (hermes:topo-faults t) "events" (quote ()))
  0)

(define (hermes:agent-paused? t name)
  (let ((paused (hash-ref (hermes:topo-faults t) "paused" #f)))
    (if (not paused)
      #f
      (let ((v (hash-ref paused name 0)))
        (and (number? v) (> v 0))))))

(define (hermes:pause-agent! t name)
  (let ((paused (hash-ref (hermes:topo-faults t) "paused" #f)))
    (if paused
      (begin
        (hash-set! paused name 1)
        (hermes:stats-bump! "inject_pauses")
        (hermes:fault-log! t "pause" name "" "" "injected")
        name)
      #f)))

(define (hermes:resume-agent! t name)
  (let ((paused (hash-ref (hermes:topo-faults t) "paused" #f)))
    (if paused
      (begin
        (hash-set! paused name 0)
        (hermes:stats-bump! "inject_resumes")
        (hermes:stats-bump! "recoveries")
        (hermes:fault-log! t "resume" name "" "" "recovered")
        name)
      #f)))

(define (hermes:inject-drops! t name n)
  (let ((drops (hash-ref (hermes:topo-faults t) "drops" #f))
        (nn (if (and (number? n) (> n 0)) n 0)))
    (if drops
      (begin
        (hash-set! drops name nn)
        (hermes:stats-set! "inject_drops"
          (+ (hermes:stats-ref "inject_drops") nn))
        (hermes:fault-log! t "inject-drops" name "" ""
          (string-append "n=" (number->string nn)))
        nn)
      0)))

(define (hermes:drops-remaining t name)
  (let ((drops (hash-ref (hermes:topo-faults t) "drops" #f)))
    (if (not drops)
      0
      (let ((v (hash-ref drops name 0)))
        (if (number? v) v 0)))))

; Consume one scheduled drop at `name` if any remain. → #t if drop fired.
; Public (exported via min) so deliver-once free-refs stay exported bindings.
(define (hermes:consume-drop! t name)
  (let ((n (hermes:drops-remaining t name)))
    (if (> n 0)
      (let ((drops (hash-ref (hermes:topo-faults t) "drops" #f)))
        (hash-set! drops name (- n 1))
        (hermes:stats-bump! "drops_consumed")
        #t)
      #f)))

(define (hermes:clear-faults! t)
  (let ((faults (hermes:topo-faults t)))
    (let ((paused (hash))
          (drops (hash)))
      (hash-set! faults "paused" paused)
      (hash-set! faults "drops" drops)
      ; keep events for post-mortem observability unless caller clears them
      (hermes:stats-bump! "recoveries")
      (hermes:fault-log! t "clear-faults" "" "" "" "cleared")
      #t)))

(define (hermes:bind-role! t name handler)
  (hash-set! (hermes:topo-roles t) name handler)
  (hermes:stats-bump! "agents_bound")
  name)

; Hot rebind of an existing agent role (does not re-count agents_bound).
(define (hermes:rebind-role! t name handler)
  (hash-set! (hermes:topo-roles t) name handler)
  (hermes:stats-bump! "role_rebinds")
  name)

; Hot replace of the route table (first-class coordination mutation).
; Topology layout: (agents routes roles inbox) — mutate routes via set-car! on cdr.
(define (hermes:set-routes! t routes)
  (set-car! (cdr t) routes)
  (hermes:stats-bump! "route_rebinds")
  routes)

; Shallow copy of route list (each edge is a 3-list) for dual-rollback baseline.
(define (hermes:copy-routes routes)
  (let loop ((xs routes) (acc (quote ())))
    (if (null? xs)
      (reverse acc)
      (let ((r (car xs)))
        (loop (cdr xs)
              (cons (list (car r) (car (cdr r)) (car (cdr (cdr r)))) acc))))))

(define (hermes:clear-inbox! t name)
  (hash-set! (hermes:topo-inbox t) name (quote ()))
  0)

; routes: list of (from region next)
; Prefer exact region match; fall back to default region "".
(define (hermes:route-next t from region)
  (let ((rs (hermes:topo-routes t)))
    (let loop ((xs rs) (fallback #f))
      (if (null? xs)
        (begin
          (if fallback
            (begin (hermes:stats-bump! "route_hits") fallback)
            (begin (hermes:stats-bump! "route_miss") #f)))
        (let ((r (car xs)))
          (let ((r-from (car r))
                (r-region (car (cdr r)))
                (r-next (car (cdr (cdr r)))))
            (if (equal? r-from from)
              (if (equal? r-region region)
                (begin (hermes:stats-bump! "route_hits") r-next)
                (if (and (equal? r-region "") (not fallback))
                  (loop (cdr xs) r-next)
                  (loop (cdr xs) fallback)))
              (loop (cdr xs) fallback))))))))

; Every agent has a bound role; every non-sink agent has at least one route out.
; sinks: agents that appear as route targets but need not route further
;         (we treat "collector" name convention + any agent with no out-route
;          as terminal if it has a role).
(define (hermes:topo-complete? t)
  (let ((agents (hermes:topo-agents t))
        (roles (hermes:topo-roles t))
        (routes (hermes:topo-routes t)))
    (let loop ((xs agents))
      (if (null? xs)
        #t
        (let ((name (car xs)))
          (if (not (procedure? (hash-ref roles name #f)))
            #f
            (loop (cdr xs))))))))

; Invoke agent handler at `at` with msg.
; → rewritten msg | 'paused | 'drop | #f (handler fail / missing)
(define (hermes:deliver-once! t at msg)
  (if (hermes:agent-paused? t at)
    (begin
      (hermes:stats-bump! "messages_failed")
      (hermes:stats-bump! "pause_hits")
      (hermes:fault-log! t "pause-hit" at
        (hermes:msg-id msg) (hermes:msg-region msg) "agent-paused")
      'paused)
    (if (hermes:consume-drop! t at)
      (begin
        (hermes:stats-bump! "messages_failed")
        (hermes:fault-log! t "drop" at
          (hermes:msg-id msg) (hermes:msg-region msg) "injected-drop")
        'drop)
      (let ((handler (hash-ref (hermes:topo-roles t) at #f)))
        (if (not (procedure? handler))
          (begin
            (hermes:stats-bump! "messages_failed")
            (hermes:fault-log! t "no-handler" at
              (hermes:msg-id msg) (hermes:msg-region msg) "missing-role")
            #f)
          (let ((out (handler msg)))
            (if out
              out
              (begin
                (hermes:stats-bump! "messages_failed")
                (hermes:fault-log! t "handler-fail" at
                  (hermes:msg-id msg) (hermes:msg-region msg) "handler-#f")
                #f))))))))

; Multi-hop deliver starting at `start` agent.
; max-hops caps loops. Terminal when agent name == msg.to OR no further route
; and agent is the intended sink (msg.to).
; → alist :ok :hops :final_at :payload | :ok #f :reason
(define (hermes:deliver! t start msg max-hops)
  (let ((cap (if (and (number? max-hops) (> max-hops 0)) max-hops 16)))
    (let loop ((at start) (m msg) (hops 0))
      (if (> hops cap)
        (begin
          (hermes:stats-bump! "messages_failed")
          (hermes:fault-log! t "max-hops" at
            (hermes:msg-id m) (hermes:msg-region m) "cap")
          (list (cons ":ok" #f)
                (cons ":reason" "max-hops")
                (cons ":hops" hops)
                (cons ":final_at" at)))
        (let ((m1 (hermes:deliver-once! t at m)))
          (cond
            ((eq? m1 'paused)
              (list (cons ":ok" #f)
                    (cons ":reason" "paused")
                    (cons ":hops" hops)
                    (cons ":final_at" at)))
            ((eq? m1 'drop)
              (list (cons ":ok" #f)
                    (cons ":reason" "drop")
                    (cons ":hops" hops)
                    (cons ":final_at" at)))
            ((not m1)
              (list (cons ":ok" #f)
                    (cons ":reason" "handler-fail")
                    (cons ":hops" hops)
                    (cons ":final_at" at)))
            (else
              (let ((m2 (hermes:msg-with-hops m1 (+ hops 1)))
                    (dest (hermes:msg-to m1)))
                (if (equal? at dest)
                  (begin
                    (hermes:stats-bump! "messages_delivered")
                    (hermes:stats-set! "hops_total"
                      (+ (hermes:stats-ref "hops_total") (+ hops 1)))
                    (hermes:stats-set! "last_delivered"
                      (+ 1 (hermes:stats-ref "last_delivered")))
                    (hermes:stats-set! "last_hops" (+ hops 1))
                    (list (cons ":ok" #t)
                          (cons ":hops" (+ hops 1))
                          (cons ":final_at" at)
                          (cons ":payload" (hermes:msg-payload m2))))
                  (let ((next (hermes:route-next t at (hermes:msg-region m2))))
                    (if (not next)
                      (begin
                        (hermes:stats-bump! "messages_failed")
                        (hermes:fault-log! t "route-miss" at
                          (hermes:msg-id m2) (hermes:msg-region m2) "no-next")
                        (list (cons ":ok" #f)
                              (cons ":reason" "route-miss")
                              (cons ":hops" (+ hops 1))
                              (cons ":final_at" at)))
                      (loop next
                            (hermes:msg-with-from m2 at)
                            (+ hops 1)))))))))))))

; Send a new message into topology at producer/start.
(define (hermes:send! t start msg max-hops)
  (hermes:stats-bump! "messages_sent")
  (hermes:deliver! t start msg max-hops))

(define (hermes:inbox-ref t name)
  (let ((v (hash-ref (hermes:topo-inbox t) name #f)))
    (if (list? v) v (quote ()))))

(define (hermes:inbox-sum t name)
  (let ((xs (hermes:inbox-ref t name)))
    (let loop ((ys xs) (acc 0))
      (if (null? ys)
        acc
        (let ((p (car ys)))
          (loop (cdr ys) (+ acc (if (number? p) p 0))))))))

(define (hermes:inbox-count t name)
  (length (hermes:inbox-ref t name)))

; Snapshot of topology structure (not live role closures): agents + routes +
; per-agent inbox counts + fault observability fields. Dual-rollback baseline.
; → alist :agents :routes :inbox_counts :paused :event_count :topo_version
(define (hermes:snapshot-topology t)
  (let ((agents (hermes:topo-agents t))
        (routes (hermes:copy-routes (hermes:topo-routes t)))
        (inbox (hermes:topo-inbox t)))
    (let loop ((xs agents) (counts (quote ())) (paused-acc (quote ())))
      (if (null? xs)
        (list (cons ":agents" agents)
              (cons ":routes" routes)
              (cons ":inbox_counts" (reverse counts))
              (cons ":paused" (reverse paused-acc))
              (cons ":event_count" (hermes:fault-event-count t))
              (cons ":topo_version" hermes:topology-version))
        (let ((n (car xs)))
          (let ((c (length (hermes:inbox-ref t n)))
                (p (if (hermes:agent-paused? t n) 1 0)))
            (loop (cdr xs)
                  (cons (cons n c) counts)
                  (if (= p 1)
                    (cons n paused-acc)
                    paused-acc))))))))

; Restore route table from a topology snapshot alist or a raw routes list.
(define (hermes:restore-topology-routes! t snap-or-routes)
  (let ((from-snap
          (if (list? snap-or-routes)
            (hermes:alist-ref ":routes" snap-or-routes #f)
            #f)))
    (let ((routes (if from-snap from-snap snap-or-routes)))
      (hermes:set-routes! t (hermes:copy-routes routes))
      (hermes:stats-bump! "rollback_ok")
      #t)))

; ── Default pure roles for star / region topology ──
;
; worker-east: payload' = payload * 2
; worker-west: payload' = payload * 3
; worker-scale: payload' = (coord-scale payload)  — free name for AST rebind probes
; router: pass-through (routing done by table)
; collector: append payload to inbox; msg.to stays collector

(define (hermes:default-worker-east msg)
  (list (hermes:msg-id msg)
        (hermes:msg-from msg)
        "collector"
        (hermes:msg-region msg)
        (* (hermes:msg-payload msg) 2)
        (hermes:msg-hops msg)))

(define (hermes:default-worker-west msg)
  (list (hermes:msg-id msg)
        (hermes:msg-from msg)
        "collector"
        (hermes:msg-region msg)
        (* (hermes:msg-payload msg) 3)
        (hermes:msg-hops msg)))

; Calls workspace binding `coord-scale` (install via hermes:install-source).
(define (hermes:default-worker-scale msg)
  (list (hermes:msg-id msg)
        (hermes:msg-from msg)
        "collector"
        (hermes:msg-region msg)
        (coord-scale (hermes:msg-payload msg))
        (hermes:msg-hops msg)))

(define (hermes:default-router-pass msg)
  msg)

(define (hermes:star-routes-normal)
  (list
    (list "producer" "" "router")
    (list "router" "east" "worker-e")
    (list "router" "west" "worker-w")
    (list "worker-e" "" "collector")
    (list "worker-w" "" "collector")))

; East/west workers swapped — coordination topology mutation target.
(define (hermes:star-routes-swapped)
  (list
    (list "producer" "" "router")
    (list "router" "east" "worker-w")
    (list "router" "west" "worker-e")
    (list "worker-e" "" "collector")
    (list "worker-w" "" "collector")))

; Failover: east traffic goes to worker-w (*3) while worker-e is down.
(define (hermes:star-routes-failover-east)
  (list
    (list "producer" "" "router")
    (list "router" "east" "worker-w")
    (list "router" "west" "worker-w")
    (list "worker-e" "" "collector")
    (list "worker-w" "" "collector")))
; Collector closes over topology so it can write inbox.
(define (hermes:default-collector t)
  (lambda (msg)
    (let ((inbox (hermes:topo-inbox t))
          (payload (hermes:msg-payload msg)))
      (let ((prev (hash-ref inbox "collector" #f)))
        (let ((xs (if (list? prev) prev (quote ()))))
          (hash-set! inbox "collector" (cons payload xs))
          (list (hermes:msg-id msg)
                (hermes:msg-from msg)
                "collector"
                (hermes:msg-region msg)
                payload
                (hermes:msg-hops msg)))))))

; Star / region topology:
;   producer → router ─east→ worker-e → collector
;                      ─west→ worker-w → collector
(define (hermes:build-star-topology)
  (let ((agents (list "producer" "router" "worker-e" "worker-w" "collector"))
        (routes (hermes:star-routes-normal)))
    (let ((t (hermes:make-topology agents routes)))
      (hermes:bind-role! t "producer" hermes:default-router-pass)
      (hermes:bind-role! t "router" hermes:default-router-pass)
      (hermes:bind-role! t "worker-e" hermes:default-worker-east)
      (hermes:bind-role! t "worker-w" hermes:default-worker-west)
      (hermes:bind-role! t "collector" (hermes:default-collector t))
      t)))

; Run N messages alternating east/west with payloads 1..N.
; factor-east / factor-west: expected transform at the worker that serves that region.
; → alist :delivered :failed :expected_sum :actual_sum :expected_count :actual_count
(define (hermes:run-region-workload-factors! t n factor-east factor-west)
  (hermes:stats-bump! "workloads_run")
  (hermes:stats-set! "last_delivered" 0)
  (let ((nn (if (and (number? n) (> n 0)) n 0))
        (fe (if (number? factor-east) factor-east 2))
        (fw (if (number? factor-west) factor-west 3)))
    (let loop ((i 1) (delivered 0) (failed 0) (expected 0))
      (if (> i nn)
        (list (cons ":delivered" delivered)
              (cons ":failed" failed)
              (cons ":expected_sum" expected)
              (cons ":actual_sum" (hermes:inbox-sum t "collector"))
              (cons ":expected_count" nn)
              (cons ":actual_count" (hermes:inbox-count t "collector")))
        (let ((region (if (= (modulo i 2) 1) "east" "west"))
              (factor (if (= (modulo i 2) 1) fe fw)))
          (let ((msg (hermes:make-msg
                       (string-append "m" (number->string i))
                       "producer"
                       "collector"
                       region
                       i)))
            (let ((r (hermes:send! t "producer" msg 16)))
              (if (hermes:alist-ref ":ok" r #f)
                (loop (+ i 1)
                      (+ delivered 1)
                      failed
                      (+ expected (* factor i)))
                (loop (+ i 1)
                      delivered
                      (+ failed 1)
                      (+ expected (* factor i)))))))))))

(define (hermes:run-region-workload! t n)
  (hermes:run-region-workload-factors! t n 2 3))

; East-only batch of n messages with payloads 1..n, expected factor f.
(define (hermes:run-east-workload! t n factor)
  (hermes:stats-bump! "workloads_run")
  (hermes:stats-set! "last_delivered" 0)
  (let ((nn (if (and (number? n) (> n 0)) n 0))
        (f (if (number? factor) factor 2)))
    (let loop ((i 1) (delivered 0) (failed 0) (expected 0))
      (if (> i nn)
        (list (cons ":delivered" delivered)
              (cons ":failed" failed)
              (cons ":expected_sum" expected)
              (cons ":actual_sum" (hermes:inbox-sum t "collector"))
              (cons ":expected_count" nn)
              (cons ":actual_count" (hermes:inbox-count t "collector")))
        (let ((msg (hermes:make-msg
                     (string-append "e" (number->string i))
                     "producer"
                     "collector"
                     "east"
                     i)))
          (let ((r (hermes:send! t "producer" msg 16)))
            (if (hermes:alist-ref ":ok" r #f)
              (loop (+ i 1) (+ delivered 1) failed (+ expected (* f i)))
              (loop (+ i 1) delivered (+ failed 1) (+ expected (* f i))))))))))