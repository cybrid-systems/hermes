; lib/hermes-min.aura — Phase 1–3 facade (Axes A + B + C + E + F)
;
; (require "hermes-min" all:)
;
; Form order: export BEFORE require (host #2766).

(export hermes:stats hermes:stats-reset! hermes:stats-ref hermes:stats-bump!
        hermes:stats-set! hermes:stats-alist hermes:alist-ref
        hermes:time-call hermes:check-eq hermes:check-true hermes:check-ge
        hermes:escape-note!
        hermes:topology-version hermes:mutate-version
        hermes:fault-version hermes:min-version
        hermes:msg-id hermes:msg-from hermes:msg-to
        hermes:msg-region hermes:msg-payload hermes:msg-hops
        hermes:make-msg hermes:msg-with-hops hermes:msg-with-from
        hermes:make-topology
        hermes:topo-agents hermes:topo-routes hermes:topo-roles
        hermes:topo-inbox hermes:topo-faults
        hermes:bind-role! hermes:rebind-role!
        hermes:set-routes! hermes:copy-routes hermes:clear-inbox!
        hermes:route-next
        hermes:topo-complete?
        hermes:deliver-once!
        hermes:deliver!
        hermes:send!
        hermes:inbox-ref hermes:inbox-sum hermes:inbox-count
        hermes:snapshot-topology hermes:restore-topology-routes!
        hermes:fault-log! hermes:fault-events hermes:fault-event-count
        hermes:fault-clear-events!
        hermes:agent-paused? hermes:pause-agent! hermes:resume-agent!
        hermes:inject-drops! hermes:drops-remaining hermes:consume-drop!
        hermes:clear-faults!
        hermes:default-worker-east hermes:default-worker-west
        hermes:default-worker-scale
        hermes:default-router-pass hermes:default-collector
        hermes:build-star-topology
        hermes:star-routes-normal hermes:star-routes-swapped
        hermes:star-routes-failover-east
        hermes:run-region-workload!
        hermes:run-region-workload-factors!
        hermes:run-east-workload!
        hermes:install-source hermes:safety-ok?
        hermes:snapshot hermes:restore hermes:rebind-safe
        hermes:count-events-kind
        hermes:failover-east! hermes:recover-normal!)

(require "hermes-measure" all:)
(require "hermes-topology" all:)
(require "hermes-mutate" all:)
(require "hermes-fault" all:)

(define hermes:min-version 3)
