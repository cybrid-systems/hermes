; examples/03-failure-recovery/main.aura
;
; Phase 3 denseness probe — failure injection + recovery denseness.
;
; Axes: C (failure & partiality) + E (observability) + F (metrology)
; (Topology A remains under test; no wire — Phase 4.)
;
; Scenario:
;   R0: baseline east workload OK
;   R1: pause worker-e → east fails with reason paused (observable)
;   R2: resume worker-e → east recovers
;   R3: inject N drops at router → exactly N failures reason=drop; rest OK
;   R4: pause worker-e + failover-east! → east traffic via worker-w (*3) recovers
;   R5: recover-normal! → baseline OK; event log retains pause/drop/failover trail
;
; Run: ./scripts/run-aura.sh examples/03-failure-recovery/main.aura

(require "hermes-min" all:)

(hermes:stats-reset!)

(display "=== Hermes 03-failure-recovery: failure denseness ===")
(newline)
(display "hermes:min-version=")
(display hermes:min-version)
(display " topology-version=")
(display hermes:topology-version)
(display " fault-version=")
(display hermes:fault-version)
(newline)

(define N-BASE 16)
(define N-DROP 5)
(define N-DROP-BATCH 12)

(display "knobs: n-base=")
(display N-BASE)
(display " n-drop=")
(display N-DROP)
(display " n-drop-batch=")
(display N-DROP-BATCH)
(newline)

(let* ((t (hermes:build-star-topology))
       (complete0 (hermes:check-true (hermes:topo-complete? t))))

  ; ── R0: baseline ──
  (hermes:clear-inbox! t "collector")
  (hermes:fault-clear-events! t)
  (let* ((r0 (hermes:run-east-workload! t N-BASE 2))
         (r0-ok
           (and (hermes:check-eq (hermes:alist-ref ":delivered" r0 0) N-BASE)
                (hermes:check-eq (hermes:alist-ref ":failed" r0 -1) 0)
                (hermes:check-eq (hermes:alist-ref ":actual_sum" r0 0)
                                 (hermes:alist-ref ":expected_sum" r0 -1)))))
    (display "R0 baseline: ")
    (write r0)
    (newline)
    (display "R0 ok=")
    (display r0-ok)
    (newline)

    ; ── R1: pause worker-e ──
    (hermes:clear-inbox! t "collector")
    (hermes:pause-agent! t "worker-e")
    (let* ((paused? (hermes:check-true (hermes:agent-paused? t "worker-e")))
           (r1 (hermes:run-east-workload! t N-BASE 2))
           (r1-del (hermes:check-eq (hermes:alist-ref ":delivered" r1 0) 0))
           (r1-fail (hermes:check-eq (hermes:alist-ref ":failed" r1 0) N-BASE))
           ; sample one send for reason
           (sample (hermes:send! t "producer"
                     (hermes:make-msg "r1-sample" "producer" "collector" "east" 1)
                     16))
           (reason-ok (hermes:check-true
                        (equal? (hermes:alist-ref ":reason" sample "") "paused")))
           (r1-ok (and paused? r1-del r1-fail reason-ok)))
      (display "R1 pause: ")
      (write r1)
      (newline)
      (display "R1 sample reason=")
      (display (hermes:alist-ref ":reason" sample #f))
      (display " ok=")
      (display r1-ok)
      (newline)

      ; ── R2: resume ──
      (hermes:resume-agent! t "worker-e")
      (hermes:clear-inbox! t "collector")
      (let* ((not-paused (hermes:check-true (not (hermes:agent-paused? t "worker-e"))))
             (r2 (hermes:run-east-workload! t N-BASE 2))
             (r2-ok
               (and not-paused
                    (hermes:check-eq (hermes:alist-ref ":delivered" r2 0) N-BASE)
                    (hermes:check-eq (hermes:alist-ref ":failed" r2 -1) 0)
                    (hermes:check-eq (hermes:alist-ref ":actual_sum" r2 0)
                                     (hermes:alist-ref ":expected_sum" r2 -1)))))
        (display "R2 resume: ")
        (write r2)
        (newline)
        (display "R2 ok=")
        (display r2-ok)
        (newline)

        ; ── R3: message drops at router ──
        (hermes:clear-inbox! t "collector")
        (hermes:inject-drops! t "router" N-DROP)
        (let* ((rem0 (hermes:check-eq (hermes:drops-remaining t "router") N-DROP))
               (r3 (hermes:run-east-workload! t N-DROP-BATCH 2))
               (r3-del (hermes:check-eq (hermes:alist-ref ":delivered" r3 0)
                                        (- N-DROP-BATCH N-DROP)))
               (r3-fail (hermes:check-eq (hermes:alist-ref ":failed" r3 0) N-DROP))
               (rem1 (hermes:check-eq (hermes:drops-remaining t "router") 0))
               (r3-ok (and rem0 r3-del r3-fail rem1)))
          (display "R3 drops: ")
          (write r3)
          (newline)
          (display "R3 ok=")
          (display r3-ok)
          (newline)

          ; ── R4: pause + failover recovery policy ──
          (hermes:clear-inbox! t "collector")
          (hermes:pause-agent! t "worker-e")
          (hermes:failover-east! t)
          (let* ((route-ok (hermes:check-true
                             (equal? (hermes:route-next t "router" "east") "worker-w")))
                 ; east via worker-w → factor 3
                 (r4 (hermes:run-east-workload! t N-BASE 3))
                 (r4-ok
                   (and route-ok
                        (hermes:check-eq (hermes:alist-ref ":delivered" r4 0) N-BASE)
                        (hermes:check-eq (hermes:alist-ref ":failed" r4 -1) 0)
                        (hermes:check-eq (hermes:alist-ref ":actual_sum" r4 0)
                                         (hermes:alist-ref ":expected_sum" r4 -1)))))
            (display "R4 failover: ")
            (write r4)
            (newline)
            (display "R4 ok=")
            (display r4-ok)
            (newline)

            ; ── R5: full recover-normal + observability ──
            (hermes:recover-normal! t)
            (hermes:clear-inbox! t "collector")
            (let* ((r5 (hermes:run-east-workload! t N-BASE 2))
                   (r5-work
                     (and (hermes:check-eq (hermes:alist-ref ":delivered" r5 0) N-BASE)
                          (hermes:check-eq (hermes:alist-ref ":failed" r5 -1) 0)
                          (hermes:check-eq (hermes:alist-ref ":actual_sum" r5 0)
                                           (hermes:alist-ref ":expected_sum" r5 -1))))
                   (n-pause (hermes:count-events-kind t "pause"))
                   (n-resume (hermes:count-events-kind t "resume"))
                   (n-drop (hermes:count-events-kind t "drop"))
                   (n-pause-hit (hermes:count-events-kind t "pause-hit"))
                   (n-failover (hermes:count-events-kind t "failover"))
                   (n-recover (hermes:count-events-kind t "recover-normal"))
                   (ev-ok
                     (and (hermes:check-ge n-pause 2)
                          (hermes:check-ge n-resume 1)
                          (hermes:check-ge n-drop N-DROP)
                          (hermes:check-ge n-pause-hit 1)
                          (hermes:check-ge n-failover 1)
                          (hermes:check-ge n-recover 1)
                          (hermes:check-ge (hermes:fault-event-count t) 10)))
                   (snap (hermes:snapshot-topology t))
                   (snap-ok
                     (and (hermes:check-true (list? (hermes:alist-ref ":paused" snap #f)))
                          (hermes:check-eq (hermes:alist-ref ":topo_version" snap 0)
                                           hermes:topology-version)
                          (hermes:check-ge (hermes:alist-ref ":event_count" snap 0) 10)))
                   (r5-ok (and r5-work ev-ok snap-ok
                               (hermes:check-true
                                 (not (hermes:agent-paused? t "worker-e"))))))
              (display "R5 recover: ")
              (write r5)
              (newline)
              (display "R5 events pause=")
              (display n-pause)
              (display " resume=")
              (display n-resume)
              (display " drop=")
              (display n-drop)
              (display " pause-hit=")
              (display n-pause-hit)
              (display " failover=")
              (display n-failover)
              (display " recover=")
              (display n-recover)
              (display " total=")
              (display (hermes:fault-event-count t))
              (newline)
              (display "R5 ok=")
              (display r5-ok)
              (newline)

              (display "stats: ")
              (write (hermes:stats-alist))
              (newline)

              (let ((all-ok
                      (and complete0 r0-ok r1-ok r2-ok r3-ok r4-ok r5-ok
                           (= (hermes:stats-ref "correctness_fail") 0)
                           (= (hermes:stats-ref "escapes") 0)
                           (>= (hermes:stats-ref "inject_pauses") 2)
                           (>= (hermes:stats-ref "inject_resumes") 1)
                           (>= (hermes:stats-ref "drops_consumed") N-DROP)
                           (>= (hermes:stats-ref "failovers") 1)
                           (>= (hermes:stats-ref "recoveries") 2)
                           (>= (hermes:stats-ref "events_logged") 10))))
                (if all-ok
                  (begin
                    (display "PASS: failure injection + recovery denseness (escapes=0)")
                    (newline)
                    (display "RESULT pass example=03-failure-recovery escapes=0")
                    (newline))
                  (begin
                    (display "FAIL: failure denseness probe")
                    (newline)
                    (display "RESULT fail example=03-failure-recovery")
                    (newline)
                    (display "  r0=")
                    (display r0-ok)
                    (display " r1=")
                    (display r1-ok)
                    (display " r2=")
                    (display r2-ok)
                    (display " r3=")
                    (display r3-ok)
                    (display " r4=")
                    (display r4-ok)
                    (display " r5=")
                    (display r5-ok)
                    (newline)
                    (display "  escapes=")
                    (display (hermes:stats-ref "escapes"))
                    (display " correctness_fail=")
                    (display (hermes:stats-ref "correctness_fail"))
                    (newline)))))))))))
