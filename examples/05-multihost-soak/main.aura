; examples/05-multihost-soak/main.aura
;
; Phase 5 denseness probe — multi-process / multi-host soak + judgment.
;
; Host A (this process): encode HMSG frames → write mailbox (E: write-file)
; Host B (child aura):   decode + pure-Aura topology deliver → outbox
; Host A: read summary (E: read-file), verify correctness
;
; Axes: D (wire+host transport E) + E (cross-host observability) + F (metrology)
;
; Binding note: use let* for paths (host internal-define is simultaneous).
;
; Run: ./scripts/run-aura.sh examples/05-multihost-soak/main.aura

(require "hermes-min" all:)

(hermes:stats-reset!)

(display "=== Hermes 05-multihost-soak: multi-process denseness ===")
(newline)
(display "hermes:min-version=")
(display hermes:min-version)
(display " host-version=")
(display hermes:host-version)
(display " wire-version=")
(display hermes:wire-version)
(newline)

(define N-SOAK 30)
(define N-SMALL 8)

(let* ((worker "examples/05-multihost-soak/worker.aura")
       (inbox "/tmp/hermes-mh-inbox.txt")
       (outbox "/tmp/hermes-mh-outbox.txt")
       (bin
         (let ((v (getenv "AURA_BIN")))
           (if (and (string? v) (> (string-length v) 0)) v "MISSING-AURA-BIN"))))
  (display "paths: worker=")
  (display worker)
  (display " inbox=")
  (display inbox)
  (display " outbox=")
  (display outbox)
  (newline)
  (display "AURA_BIN=")
  (display bin)
  (newline)
  (display "knobs: n-small=")
  (display N-SMALL)
  (display " n-soak=")
  (display N-SOAK)
  (newline)

  ; ── R0: multi-process happy path ──
  (let* ((r0 (hermes:host-send-batch! N-SMALL worker inbox outbox #f))
         (r0-ok
           (and (hermes:check-true (hermes:alist-ref ":ok" r0 #f))
                (hermes:check-eq (hermes:alist-ref ":shell" r0 -1) 0)
                (hermes:check-eq (hermes:alist-ref ":delivered" r0 0) N-SMALL)
                (hermes:check-eq (hermes:alist-ref ":payload_sum" r0 0)
                                 (hermes:alist-ref ":expected_payload_sum" r0 -1))
                (hermes:check-eq (hermes:alist-ref ":collector_sum" r0 0)
                                 (hermes:alist-ref ":expected_collector_sum" r0 -1))
                (hermes:check-eq (hermes:alist-ref ":refused" r0 -1) 0)
                (hermes:check-eq (hermes:alist-ref ":failed" r0 -1) 0))))
    (display "R0 batch: ")
    (write r0)
    (newline)
    (display "R0 ok=")
    (display r0-ok)
    (newline)

    ; ── R1: soak ──
    (let* ((r1 (hermes:host-send-batch! N-SOAK worker inbox outbox #f))
           (r1-ok
             (and (hermes:check-true (hermes:alist-ref ":ok" r1 #f))
                  (hermes:check-eq (hermes:alist-ref ":shell" r1 -1) 0)
                  (hermes:check-eq (hermes:alist-ref ":delivered" r1 0) N-SOAK)
                  (hermes:check-eq (hermes:alist-ref ":payload_sum" r1 0)
                                   (hermes:alist-ref ":expected_payload_sum" r1 -1))
                  (hermes:check-eq (hermes:alist-ref ":collector_sum" r1 0)
                                   (hermes:alist-ref ":expected_collector_sum" r1 -1)))))
      (display "R1 soak: ")
      (write r1)
      (newline)
      (display "R1 ok=")
      (display r1-ok)
      (newline)

      ; ── R2: bad frames refused across process boundary ──
      (let* ((r2 (hermes:host-send-batch! N-SMALL worker inbox outbox #t))
             (r2-ok
               (and (hermes:check-true (hermes:alist-ref ":ok" r2 #f))
                    (hermes:check-eq (hermes:alist-ref ":delivered" r2 0) N-SMALL)
                    (hermes:check-ge (hermes:alist-ref ":refused" r2 0) 2)
                    (hermes:check-eq (hermes:alist-ref ":collector_sum" r2 0)
                                     (hermes:alist-ref ":expected_collector_sum" r2 -1)))))
        (display "R2 with-bad: ")
        (write r2)
        (newline)
        (display "R2 ok=")
        (display r2-ok)
        (newline)

        ; ── R3: escape discipline + denseness judgment ──
        (let* ((esc (hermes:stats-ref "escapes"))
               (hw (hermes:stats-ref "host_writes"))
               (hr (hermes:stats-ref "host_reads"))
               (hs (hermes:stats-ref "host_shells"))
               (hok (hermes:stats-ref "host_ok"))
               (hf (hermes:stats-ref "host_fail"))
               (esc-ok (hermes:check-ge esc 1))
               (iso-ok (hermes:check-eq esc (+ hw hr hs)))
               (io-ok (and (hermes:check-ge hw 3)
                           (hermes:check-ge hr 3)
                           (hermes:check-ge hs 3)
                           (hermes:check-eq hf 0)
                           (hermes:check-ge hok 9)))
               (mh-ok (hermes:check-ge (hermes:stats-ref "multihost_msgs")
                                       (+ N-SMALL N-SOAK N-SMALL)))
               (r3-ok (and esc-ok iso-ok io-ok mh-ok)))
          (display "R3 escapes=")
          (display esc)
          (display " host_writes=")
          (display hw)
          (display " host_reads=")
          (display hr)
          (display " host_shells=")
          (display hs)
          (display " host_ok=")
          (display hok)
          (display " host_fail=")
          (display hf)
          (newline)
          (display "R3 ok=")
          (display r3-ok)
          (newline)

          (display "stats: ")
          (write (hermes:stats-alist))
          (newline)

          (let ((all-ok
                  (and r0-ok r1-ok r2-ok r3-ok
                       (= (hermes:stats-ref "correctness_fail") 0)
                       (= (hermes:stats-ref "host_fail") 0)
                       (>= (hermes:stats-ref "escapes") 1)
                       (>= (hermes:stats-ref "wire_encode") N-SMALL))))
            (if all-ok
              (begin
                (display "PASS: multi-process soak + denseness judgment")
                (newline)
                (display "JUDGMENT: practically dense on single-machine multi-process S_Hermes")
                (newline)
                (display "  core=V_A topology+schema; E=host FS+shell metered escapes=")
                (display (hermes:stats-ref "escapes"))
                (newline)
                (display "RESULT pass example=05-multihost-soak escapes=")
                (display (hermes:stats-ref "escapes"))
                (display " soak=")
                (display N-SOAK)
                (newline))
              (begin
                (display "FAIL: multihost denseness probe")
                (newline)
                (display "RESULT fail example=05-multihost-soak")
                (newline)
                (display "  r0=")
                (display r0-ok)
                (display " r1=")
                (display r1-ok)
                (display " r2=")
                (display r2-ok)
                (display " r3=")
                (display r3-ok)
                (newline)
                (display "  escapes=")
                (display (hermes:stats-ref "escapes"))
                (display " host_fail=")
                (display (hermes:stats-ref "host_fail"))
                (display " correctness_fail=")
                (display (hermes:stats-ref "correctness_fail"))
                (newline)
                (display "  last worker log (if any): see /tmp/hermes-mh-worker.log")
                (newline)))))))))
